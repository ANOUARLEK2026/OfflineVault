<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen: same midnight gradient as the app + the vault mark. Replaces Capacitor's default splash.png -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#0F1630" android:endColor="#050814"/>
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/vault_splash_logo" android:gravity="center"/>
    </item>
</layer-list>
